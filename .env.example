NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local tooling only — needed to apply migrations with
# `node scripts/apply-migrations.mjs`. The service-role key above cannot run
# DDL, because it only reaches PostgREST. Create one at
# https://supabase.com/dashboard/account/tokens (account-wide; never deploy it).
SUPABASE_ACCESS_TOKEN=

# Alternative to the token above: a direct Postgres URI
# (Supabase → Project Settings → Database → Connection string → URI).
# Requires `npm i -D pg`.
DATABASE_URL=

STEAM_API_KEY=

# Required in production — Vercel sends Authorization: Bearer <value> on cron hits.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Canonical site URL for CSRF origin checks in production (e.g. https://gameatlas.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Optional — enhances natural-language explanations in /ask. Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
